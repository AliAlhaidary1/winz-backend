# Copy to winz-api/.env on the VPS and fill in real values.
APP_NAME="Winz API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
WINZ_API_TOKEN=WinzSecure2026!

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=winz
DB_USERNAME=winz
DB_PASSWORD=change-this-strong-password

# Used by docker-compose.prod.yml for the MySQL container itself.
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=winz
MYSQL_USER=winz
MYSQL_PASSWORD=change-this-strong-password
